#!/usr/bin/env bash
# Round-697 source-controlled pre-push gate for AED worker
# sessions ONLY.
#
# AUTHORITATIVE local network-push boundary.
#
# Git invokes pre-push with:
#   $1 = remote name (typically "origin")
#   $2 = remote URL
# and passes ref pairs via stdin in the form
#   <local_ref> <local_sha> <remote_ref> <remote_sha>
# one per ref being pushed. We read stdin and validate each
# outgoing <local_sha> against:
#   1. canonical committed-state scanner (same entry as CI)
#   2. canonical provenance consistency (same validator as the
#      supervisor's round-697 post-push defense in depth)
#
# Both validators operate on COMMITTED bytes only; the hook
# does NOT validate the mutable working tree, staged set, or
# index. This is the key invariant — we evaluate the bytes
# Git has committed for the outgoing tip.
#
# On validator failure the hook returns non-zero. Git then
# refuses to perform the push; the remote branch MUST NOT
# advance. The worker can correct the local state and retry.
#
# The hook refuses to run when AED_AUTODEV_WORKER is unset
# (belt-and-braces against accidental operator inheritance).

set -uo pipefail

remote_name="${1:-}"
remote_url="${2:-}"

if [[ "${AED_AUTODEV_WORKER:-}" != "1" ]]; then
    echo "aed-pre-push: refusing to run; AED_AUTODEV_WORKER!=1" >&2
    exit 1
fi

if [[ -z "${AED_WORKER_PRELAUNCH_HEAD:-}" ]]; then
    echo "aed-pre-push: AED_WORKER_PRELAUNCH_HEAD is empty; aborting push" >&2
    exit 1
fi

# Resolve repo root.
repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "${repo_root}" ]]; then
    echo "aed-pre-push: not inside a git working tree" >&2
    exit 1
fi

# Read the ref-push protocol lines from stdin. Git passes
# one line per ref, format:
#   <local_ref> SP <local_sha> SP <remote_ref> SP <remote_sha>
# We iterate and validate each outgoing <local_sha>. A delete
# branch has empty <local_sha>; we treat that as a hard
# operator action outside the AED worker boundary.
declare -i exit_code=0
while read -r local_ref local_sha remote_ref remote_sha ; do
    # Skip blank lines / lines that are not 4 fields.
    if [[ -z "${local_ref:-}" ]]; then continue; fi
    if [[ -z "${local_sha:-}" ]]; then
        echo "aed-pre-push: refusing non-branch or delete push (local_sha empty for ${local_ref})" >&2
        exit_code=1
        continue
    fi
    # We only gate branch pushes (refs/heads/*), not tags
    # (those should be forbidden by `git push --no-tags`
    # convention but be defensive).
    case "${local_ref}" in
        refs/heads/*) ;;
        *)
            echo "aed-pre-push: refusing non-branch push (${local_ref})" >&2
            exit_code=1
            continue
            ;;
    esac
    # No-op: identical prelaunch and outgoing SHA. Should not
    # happen because Git short-circuits no-change pushes before
    # invoking the hook, but defensive.
    if [[ "${AED_WORKER_PRELAUNCH_HEAD}" == "${local_sha}" ]]; then
        continue
    fi
    # Round-1064 P2: capture the gate output via command
# substitution instead of writing to a predictable
# ``/tmp/.aed-prepush-out.$$.txt`` file. The previous
# implementation allowed another user on a shared ``/tmp``
# to pre-create the file as a symlink (TOCTOU) and it
# leaked the temp file when ``python3`` was killed because
# ``rm -f`` only ran on the normal path. Command
# substitution has neither problem. Capture ``$?``
# immediately after the substitution so the gate's true
# exit code is preserved (the earlier ``if !`` form
# lost the code because ``$?`` after the test reflects
# the inverted test result, not the original exit code).
    gate_out="$(python3 -m autocoder_supervisor.push_gate validate \
            --repo-root "${repo_root}" \
            --prelaunch "${AED_WORKER_PRELAUNCH_HEAD}" \
            --outgoing "${local_sha}" \
            --check scanner \
            --check provenance 2>&1)"
    gate_rc=$?
    case "${gate_rc}" in
        0) ;;
        2)
            echo "aed-pre-push: BLOCKED — outgoing SHA ${local_sha} failed deterministic push gate" >&2
            echo "--- structured payload ---" >&2
            echo "${gate_out}" >&2
            echo "--- fix and retry ---" >&2
            echo "  - run interactively: PYTHONPATH=. python3 -m autocoder_supervisor.push_gate validate --repo-root . --prelaunch ${AED_WORKER_PRELAUNCH_HEAD} --outgoing ${local_sha} --check scanner --check provenance" >&2
            echo "  - if scanner failure: see scripts/canonical_scanner.py" >&2
            echo "  - if provenance failure: see tests/test_round_push_gate_hooks.py case PRE_COMMIT_FINALIZER_FAILURE" >&2
            exit_code=1
            ;;
        *)
            echo "aed-pre-push: BLOCKED — push_gate exited ${gate_rc}" >&2
            echo "${gate_out}" >&2
            exit_code=1
            ;;
    esac
done

exit "${exit_code}"
